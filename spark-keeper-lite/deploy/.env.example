# =============================================================================
#  spark-keeper 环境变量模板
#
#  用法：cp .env.example .env  然后改带 「必改」标记的项。
#  说明：.env 只在「同名系统环境变量不存在」时生效（方便命令行临时覆盖）。
#        docker compose 也会读这个文件做变量替换（见 docker-compose.yml）。
#
#  ⚠️ 本文件不要提交到公开仓库（里面有密钥位）。.gitignore 已排除 .env。
# =============================================================================

# ---------------------------------------------------------------------------
# 1. 基础
# ---------------------------------------------------------------------------
# 运行环境：prod = 生产（错误响应不带堆栈、必须有显式密钥）；dev = 本机开发
SK_ENV=prod

# 监听地址与端口。容器里固定 0.0.0.0:8000，由 compose 的 ports 决定对外端口
SK_HOST=0.0.0.0
SK_PORT=8000

# 数据目录（数据库、登录态、截图、日志、备份都在这里）—— 必须持久化
SK_DATA_DIR=/app/data

# 项目根（前端产物 `web/static` 所在的那一层）。
# 一般**不用设**：config.py 会自动判断「哪一层真的有 web/static」，开发树与交付树都正确；
# Dockerfile / docker-compose / start.sh / start.bat 都显式设成 /app 或脚本所在目录，
# 只有目录结构不常规、或想强制指定时才需要手工设置。
# SK_PROJECT_DIR=/app

# 对外访问地址【必改】：支付同步跳转 / 回调地址拼接要用，写成你的域名
SK_PUBLIC_URL=https://spark.example.com

# 可信反向代理网段：只有来自这些地址的请求才采信 X-Forwarded-For（防伪造真实 IP）
# Docker 默认桥接网段是 172.16.0.0/12；宿主 Nginx 反代写 127.0.0.1
SK_TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1

# 站点时区（任务时间按它解释；服务器 UTC 也能正常跑）
SK_TIMEZONE=Asia/Shanghai

# 排障开关：设 1 时 CLI 出错会打印完整堆栈（正常运行时不要开）
# SK_DEBUG=1

# ---------------------------------------------------------------------------
# 2. 安全【必改】
# ---------------------------------------------------------------------------
# JWT 签名 / 凭据加密密钥。要求 ≥32 字符，生成方式：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# 不填会自动生成到 data/secret.key —— 生产环境不要依赖自动生成：
# 容器重建后旧令牌全部失效，多容器部署还会各生成一份导致互相不认。
SK_SECRET=

# 访问令牌 / 刷新令牌有效期（秒）
SK_ACCESS_TTL=7200
SK_REFRESH_TTL=1209600

# 单 IP 每分钟请求上限（应用内限流，0 = 关闭；边缘限流在 nginx.conf）
SK_RATE_LIMIT_PER_MINUTE=240

# 连续登录失败几次锁定、锁多久（秒）
SK_MAX_LOGIN_FAIL=8
SK_LOGIN_LOCK_SECONDS=600

# 首次启动自动创建的管理员用户名与邮箱
SK_ADMIN_USER=admin
SK_ADMIN_EMAIL=

# 想指定初始密码就填这里（不填则随机生成并写入 data/INITIAL_ADMIN.txt）
# SK_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# 3. 数据库
# ---------------------------------------------------------------------------
# 默认 $SK_DATA_DIR/spark.db；单独挂盘或用绝对路径时再改
# SK_DB_PATH=/app/data/spark.db
SK_DB_BUSY_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# 4. 邮件 / 短信（不发验证码就不用配）
# ---------------------------------------------------------------------------
SK_SMTP_HOST=
SK_SMTP_PORT=465
SK_SMTP_USER=
SK_SMTP_PASSWORD=
SK_SMTP_FROM=
SK_SMTP_SSL=1

# 短信通道（留空 = 不真发，验证码写进日志，便于本地跑通流程）
SK_SMS_PROVIDER=
SK_SMS_ACCESS_KEY=
SK_SMS_SECRET_KEY=
SK_SMS_SIGN=
SK_SMS_TEMPLATE=

# ---------------------------------------------------------------------------
# 5. 浏览器自动化（抖音托管）
# ---------------------------------------------------------------------------
# 不填则自动探测浏览器（Windows 优先 Edge，其次 Chrome/Chromium；容器里固定指向 chromium）
SK_CHROME_PATH=/usr/bin/chromium
# Chromium 沙箱：auto（root/容器自动关）| 1 强制关 | 0 强制开
# 容器里（尤其宿主机是老内核 CentOS 7）必须关，否则报 No usable sandbox!
SK_CHROME_NO_SANDBOX=auto
# 低配模式（1~2 核小机器/容器建议开）：关软件光栅、GPU 合成，限制光栅线程
SK_CHROME_LOW_RESOURCE=0
# 单次页面操作超时（秒）。弱 CPU 上抖音页面很重，报 Runtime.evaluate 超时就调大
SK_CDP_PAGE_TIMEOUT=30
# 容器环境标记（一般不用设）：程序会自动识别 /.dockerenv、/proc/1/cgroup。
# 某些托管环境（K8s/自定义容器）识别不出来时，手工设 1 让沙箱判断走容器分支。
SK_IN_CONTAINER=
SK_BROWSER_HEADLESS=1
SK_BROWSER_WIDTH=1366
SK_BROWSER_HEIGHT=900
# 同时运行的浏览器实例上限（吃内存，2GB 内存的机器建议 1）
SK_MAX_CONCURRENT_BROWSERS=2
# 1 = 每日执行次数不限（自托管默认；设 0 恢复按套餐计次）
SK_UNLIMITED_TASK_RUNS=1
# 单个任务超时（秒）与失败重试退避（秒）
SK_TASK_TIMEOUT=180
SK_TASK_RETRY_BACKOFF=60
# 1 = 演示模式：不开真浏览器，用于本机/CI 跑通 UI 流程
SK_DEMO_MODE=0

# 登录态文件、截图、上传目录（默认都在数据目录下）
# SK_SESSION_DIR=/app/data/sessions
# SK_SCREENSHOT_DIR=/app/data/screenshots
# SK_UPLOAD_DIR=/app/data/uploads

# ---------------------------------------------------------------------------
# 6. 调度器
# ---------------------------------------------------------------------------
# 1 = Web 进程内同时跑调度器（单容器模式）
# 0 = 只起 Web，由单独的 worker 容器跑调度器（多容器模式，见 --profile worker）
SK_SCHEDULER_ENABLED=1
SK_SCHEDULER_TICK=20
# 日志 / 会话 / 验证码保留天数（调度器每天清理一次；0 = 不清理）
SK_LOG_KEEP_DAYS=30
# 多容器时给每个 worker 一个固定 id（心跳表用它区分）
# SK_WORKER_ID=scheduler-1

# ---------------------------------------------------------------------------
# 6.5 跨域白名单（默认关闭；只有「前端放静态托管」时才需要）
# ---------------------------------------------------------------------------
# 典型场景：前端静态文件放 Netlify / Vercel / 对象存储，后端（Python + Chromium）
# 仍跑在服务器上。此时浏览器发的是跨域请求，必须把前端来源列进白名单。
# 注意：整站部署（同一个域名提供页面和接口）**不要**设置它，保持默认空最安全。
#   SK_CORS_ORIGINS=https://app.example.com,https://spark.example.netlify.app
SK_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# 7. 在线支付（仅 pro 版）
# ---------------------------------------------------------------------------
# ⚠️ 支付参数**不在**这份 .env 里，而是存在站点的 site_configs 表，
#    由管理员在后台「站点配置」页（PUT /api/v1/admin/configs）维护：
#      pay.enabled            0/1        总开关（默认 0；关闭时用户端只显示卡密渠道）
#      pay.channel            默认渠道：easypay / alipay / wechat
#      pay.easypay_url        易支付网关地址，例如 https://pay.example.com
#      pay.easypay_pid        商户号
#      pay.easypay_key        商户密钥（MD5 签名用）
#      pay.easypay_type       默认支付类型（alipay / wxpay）
#      pay.easypay_sign_type  签名类型，默认 MD5（RSA 预留未实现）
#    回调/跳回地址（由代码按 SK_PUBLIC_URL 拼接，也可在后台覆盖）：
#      https://<你的域名>/api/v1/pay/notify/easypay     ← 必须公网可达
#      https://<你的域名>/api/v1/pay/return
#    排障：回调进来先落 payment_notifications 表（含原始报文与验签结果），
#          失败也能在后台看到，不会「单子丢了查不到」。

# ---------------------------------------------------------------------------
# 8. Docker Compose 专用（这些只影响宿主机侧，不传给应用）
# ---------------------------------------------------------------------------
# 宿主机监听端口 / 绑定地址（默认只绑本机，公网走 Nginx）
SK_HTTP_PORT=8000
SK_BIND=127.0.0.1
# 镜像版本标签
SK_VERSION=1.0.0
TZ=Asia/Shanghai
# 入口脚本等待数据库的最长秒数
SK_DB_WAIT_SECONDS=30
